# Self-hosted MongoDB connection string.
# - Running the backend directly on the host (npm run dev:backend): mongodb://127.0.0.1:27017/safecity_mk
# - Running via `docker compose up` (see below): mongodb://mongodb:27017/safecity_mk
#   ("mongodb" is the service name from docker-compose.yml, resolved via the compose network's DNS)
# For a MongoDB replica set / Kubernetes StatefulSet, use something like:
# mongodb://safechain-mongodb-0.safechain-mongodb:27017,safechain-mongodb-1.safechain-mongodb:27017/safecity_mk?replicaSet=rs0
MONGODB_URI=mongodb://mongodb:27017/safecity_mk

# Optional: override the database name independently of MONGODB_URI's path.
MONGODB_DB_NAME=safecity_mk

# Required in production. Use the same value for seed/import and runtime lookup.
SECURITY_CODE_PEPPER=replace-with-a-long-random-server-secret

# Required in production. 32 bytes encoded as hex or base64url.
MEMO_ENCRYPTION_KEY=

# Keep true while developing so local demo tickets still work before MongoDB is seeded.
DEMO_FALLBACK=true

# Keep false outside demos. When false, /api/demo-codes returns no public codes.
PUBLIC_DEMO_CODES_ENABLED=false

# Solana devnet verification settings.
SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com
TREASURY_ADDRESS=CRQ3vWquPewjJhfvuJFVWiW1qkwoSD94W694SjkU6JuM

# Current implemented mode: public Solana transfer with encrypted memo.
PAYMENT_PRIVACY_MODE=direct_onchain_encrypted_memo

# Required for admin-only endpoints such as memo decryption.
ADMIN_TOKEN=

# Optional read-only/restricted operational tokens for admin panel reads.
REVIEWER_TOKEN=
FINANCE_TOKEN=

# Optional separate token for camera/model ingestion. Falls back to ADMIN_TOKEN.
CAMERA_INGEST_TOKEN=

# Optional real vehicle registry adapter. Without it, local seeded plates are used for dev.
REGISTRY_API_URL=
REGISTRY_API_TOKEN=

# --- docker-compose.yml settings ---
# This same .env file is loaded by `docker compose` for both variable substitution
# in docker-compose.yml and as the backend container's env_file. All variables above
# this point are passed straight through to the backend container as-is.

# Backend's internal listen port (used inside the compose network and, if you
# uncomment backend's "ports" mapping in docker-compose.yml, on the host too).
BACKEND_PORT=8787

# Host port the frontend (nginx) is published on, e.g. http://localhost:8080
FRONTEND_HOST_PORT=8080

# Uncomment/use only if you uncomment mongodb's "ports" mapping in docker-compose.yml
# to reach MongoDB from the host for debugging (e.g. mongosh, Compass).
# MONGO_HOST_PORT=27017

# Uncomment/use only if you uncomment backend's "ports" mapping in docker-compose.yml
# to call the API directly from the host without going through the frontend.
# BACKEND_HOST_PORT=8787

# Official MongoDB image tag used for the mongodb service.
MONGO_IMAGE_TAG=7

# Names for the custom bridge network and the named volume MongoDB's data is
# persisted to (survives `docker compose down`; removed only with `-v`/`--volumes`).
COMPOSE_NETWORK_NAME=safechain-network
MONGO_VOLUME_NAME=safechain_mongodb_data
